BasedOnStyle: Google

IncludeBlocks: Regroup
IncludeCategories:
  # Std headers
  - Regex: '<[[:alnum:]_.]+>'
    Priority: 2

  # Other headers
  - Regex: '.*'

---
Language: C

UseTab: Never
DerivePointerAlignment: false
PointerAlignment: Right
ReferenceAlignment: Right
---
Language: Cpp

UseTab: Never
DerivePointerAlignment: false
PointerAlignment: Right
ReferenceAlignment: Right

WrapNamespaceBodyWithEmptyLines: Always
